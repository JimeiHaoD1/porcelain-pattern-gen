        <mxCell id="sw2_mount" value="花朵挂接策略：axis integration&#xa;记录主轴—花朵融合关系，承托枝数量 = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontSize=14;" vertex="1" parent="sw2_box">
          <mxGeometry x="80" y="480" width="490" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="sw3_condition" value="进入条件&#xa;花朵作为方向明确的枝端；允许花位在领域内变化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7D31;fontSize=14;" vertex="1" parent="sw3_box">
