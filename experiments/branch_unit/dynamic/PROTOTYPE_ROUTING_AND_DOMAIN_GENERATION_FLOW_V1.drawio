        <mxCell id="sw31" value="proto_sw_3_1&#xa;单枝端花 / 轻量&#xa;侧枝服从终端方向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CBAD;strokeColor=#C65911;fontSize=14;fontStyle=1;" vertex="1" parent="sw3_box">
          <mxGeometry x="35" y="285" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="sw32" value="proto_sw_3_2&#xa;双枝端花 / 中等密度&#xa;较强主枝 + 上侧倾向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CBAD;strokeColor=#C65911;fontSize=14;fontStyle=1;" vertex="1" parent="sw3_box">
