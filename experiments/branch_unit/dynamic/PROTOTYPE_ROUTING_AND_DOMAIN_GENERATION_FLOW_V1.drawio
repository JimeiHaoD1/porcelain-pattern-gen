        </mxCell>
        <mxCell id="sw2_box" value="SW-2 领域：轴线贯穿 / 花轴一体" style="swimlane;horizontal=1;startSize=40;rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;swimlaneFillColor=#F3F8FC;strokeColor=#5B9BD5;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="735" y="570" width="650" height="570" as="geometry"/>
        </mxCell>
        <mxCell id="sw3_box" value="SW-3 领域：切线延伸 / 枝端着花" style="swimlane;horizontal=1;startSize=40;rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;swimlaneFillColor=#FFF7F2;strokeColor=#ED7D31;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1430" y="570" width="650" height="570" as="geometry"/>
        </mxCell>
        <mxCell id="sw1_condition" value="进入条件&#xa;花位固定；花位与波谷/谷侧具有承托关系" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#70AD47;fontSize=14;" vertex="1" parent="sw1_box">
          <mxGeometry x="30" y="65" width="590" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="sw1_choice" value="目标风格？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;fontStyle=1;" vertex="1" parent="sw1_box">
          <mxGeometry x="220" y="160" width="210" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="sw11" value="proto_sw_1_1&#xa;密 / 短枝频繁交替&#xa;承托 + 包绕倾向" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6E0B4;strokeColor=#548235;fontSize=14;fontStyle=1;" vertex="1" parent="sw1_box">
          <mxGeometry x="35" y="285" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="sw13" value="proto_sw_1_3&#xa;疏 / 少量长扫枝&#xa;承托为主，不强制包绕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6E0B4;strokeColor=#548235;fontSize=14;fontStyle=1;" vertex="1" parent="sw1_box">
          <mxGeometry x="355" y="285" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="sw1_rules" value="领域内变化规则&#xa;固定：花位、花数、谷位对应语义&#xa;可变：主干振幅/弧长/曲率、L1数量、疏密繁简&#xa;约束：变形后波谷仍服务固定花位；先生成承托枝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FAF1;strokeColor=#70AD47;fontSize=14;align=left;spacingLeft=12;" vertex="1" parent="sw1_box">
          <mxGeometry x="35" y="405" width="580" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="sw2_condition" value="进入条件&#xa;花朵是连续主轴视觉元素，不需要独立承托枝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B9BD5;fontSize=14;" vertex="1" parent="sw2_box">
          <mxGeometry x="30" y="65" width="590" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="sw23" value="proto_sw_2_3&#xa;宽阔主扫枝主导&#xa;沿主轴两侧组织节奏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BDD7EE;strokeColor=#2E75B6;fontSize=15;fontStyle=1;" vertex="1" parent="sw2_box">
