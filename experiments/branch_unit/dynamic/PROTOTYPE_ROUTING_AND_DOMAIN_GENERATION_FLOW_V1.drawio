          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sw1_box" value="SW-1 领域：波峰波谷 / 谷位承托" style="swimlane;horizontal=1;startSize=40;rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;swimlaneFillColor=#F4FAF1;strokeColor=#70AD47;fontSize=18;fontStyle=1;" vertex="1" parent="1">
