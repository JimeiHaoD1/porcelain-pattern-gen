        <mxCell id="input" value="输入需求 / 场景条件&#xa;可选：显式 prototype_id、花朵数量、花—主干关系、期望疏密繁简、production seed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#5B9BD5;fontSize=16;fontStyle=1;" vertex="1" parent="1">
