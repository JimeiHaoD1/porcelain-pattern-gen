  <diagram id="prototype-routing-v1" name="原型路由与领域生成主链">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="缠枝结构生成：原型路由、领域内变化与共享生产主链" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F4E78;fontColor=#FFFFFF;strokeColor=#15344F;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
