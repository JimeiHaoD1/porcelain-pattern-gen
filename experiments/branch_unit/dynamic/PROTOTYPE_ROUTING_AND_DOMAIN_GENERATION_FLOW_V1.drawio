        </mxCell>
        <mxCell id="route_features" value="路由特征提取&#xa;① 花是否属于主轴视觉元素  ② 花是否位于枝端  ③ 花数  ④ 谷位承托关系  ⑤ 目标疏密风格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#5B9BD5;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="760" y="235" width="600" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="router" value="原型路由器&#xa;显式指定优先；否则先判定 SW 领域，再选择具体原型&#xa;原型选择不由 seed 决定" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;fontStyle=1;" vertex="1" parent="1">
